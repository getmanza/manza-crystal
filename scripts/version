#!/usr/bin/env bash
# bin/release adapter: print the current version, or write a new one into every
# tracked file that carries it (shard.yml and the Zazu::VERSION constant).
set -euo pipefail
cd "$(dirname "$0")/.."

if [ $# -eq 0 ]; then
  sed -nE 's/^version: (.+)$/\1/p' shard.yml
  exit 0
fi

sed -i.bak -E "s/^version: .+$/version: $1/" shard.yml
sed -i.bak -E "s/^  VERSION = \"[^\"]+\"$/  VERSION = \"$1\"/" src/zazu.cr
rm -f shard.yml.bak src/zazu.cr.bak
