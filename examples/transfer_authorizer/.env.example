# Copy to .env and fill in. Never commit .env.

# https://ma.manza.finance (Morocco), https://za.manza.finance (South Africa),
# or https://ma.manza.dev for staging.
MANZA_BASE_URL=https://ma.manza.finance

# Key A: creates transfer drafts (scope transfers:write). preflight.cr also
# reads with it: entity:read, accounts:read, webhook_endpoints:read,
# beneficiaries:read. Bind it to an IP allowlist to pay new payees.
MANZA_CREATOR_API_KEY=
# Key B: answers the challenges (scope transfers:authorize), bound to an IP
# allowlist. Must differ from key A.
MANZA_AUTHORIZER_API_KEY=
# Signing secret of the webhook endpoint enrolled as transfer authorizer.
MANZA_AUTHORIZER_SECRET=

# The account to pay from and a beneficiary whose default bank account is a
# trusted payee, or a new one ("Approve transfers to new payees" on).
MANZA_ACCOUNT_ID=
MANZA_BENEFICIARY_ID=

# The local port server.cr listens on; point your tunnel at it.
PORT=4599

# false: decline transfers to payees not trusted yet (payee_trusted false in
# the webhook) instead of authorizing, and so trusting, them.
ALLOW_NEW_PAYEES=true
